# AutoForm AI Server Environment Configuration
PORT=3000
NODE_ENV=production

# Client Rate Limiting (per hour per client ID / IP)
RATE_LIMIT_PER_HOUR=150

# Optional: Shared Secret token between extension and server (leave empty to disable)
API_SECRET_KEY=

# Database Connection (Postgres: Supabase or Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/autoform
DATABASE_URL_TEST=

# JWT Session Authentication
JWT_SECRET=your_long_random_jwt_secret_key_at_least_32_chars

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay Payments (One-time Pro Passes)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin Usage Dashboard
ADMIN_STATS_TOKEN=your_secure_admin_stats_token

# Reverse Proxy Hop Count (1 for Render / standard reverse proxy)
TRUST_PROXY_HOPS=1

# Paid Passes Gate (default false; when false, Pro passes disabled and limit screen shows coming soon)
PAYMENTS_ENABLED=false

# Backward Compatibility for v2.0.2 Extension Users (Phased Rollout)
# Set to true during extension store update window to allow unauthenticated solves under IP cap
LEGACY_ANON_SOLVE=false
LEGACY_DAILY_IP_CAP=150
# Guest trial per-IP daily AI-answer abuse cap (two forms are separately reserved server-side).
GUEST_TRIAL_DAILY_IP_CAP=120

# 1. Groq (Primary Provider - Ultra-Fast Inference)
# Active Models:
# - llama-3.1-8b-instant (Recommended & Active)
# - openai/gpt-oss-120b
# - openai/gpt-oss-20b
# - qwen/qwen3.6-27b
# - deepseek-r1-distill-llama-70b
GROQ_API_KEYS=gsk_your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# 2. Google Gemini (Secondary Provider)
# Active Models:
# - gemini-3.5-flash-lite (Recommended & Active)
# - gemini-2.5-flash
# - gemini-1.5-flash
# - gemini-1.5-pro
GEMINI_API_KEYS=AIzaSy_your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. OpenRouter (Free Tier Auto-Routing - Infinite Token Backup)
# Active Models:
# - openrouter/free (Recommended: Automatically routes across available free models)
# - nvidia/nemotron-3.5-lightning:free
# - google/gemma-4-26b-a4b-it:free
# - minimax/minimax-m3:free
# - z-ai/glm-5.2:free
OPENROUTER_API_KEYS=sk-or-v1-your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free

# 4. NVIDIA NIM (Fallback Provider)
# Active Models:
# - meta/llama-3.3-70b-instruct (Recommended & Active)
# - meta/llama-3.1-8b-instruct
# - nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_API_KEYS=nvapi-your_nvidia_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
